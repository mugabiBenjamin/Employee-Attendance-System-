# Database Configuration
# Replace 'username', 'password', and 'employee_management_db' with your PostgreSQL credentials and database name
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/employee_management_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=employee_management_db
DATABASE_USER=username
DATABASE_PASSWORD=password

# Application Settings
APP_NAME=Employee_Management_System
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development
API_V1_STR=/api/v1
# Generate a secure random key (at least 32 characters) for general application security
SECRET_KEY=change-this-to-a-secure-random-key-min-32-chars
# Generate a secure random key (at least 32 characters) for JWT encoding
JWT_SECRET_KEY=change-this-to-another-secure-random-key-min-32-chars
# JWT algorithm (supported: HS256, HS384, HS512)
JWT_ALGORITHM=HS256
# Access token expiry in minutes (default: 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiry in days (default: 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Number of bcrypt rounds for password hashing (minimum: 12)
BCRYPT_ROUNDS=12

# CORS Settings
# Comma-separated list of allowed origins for CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Email Configuration
# Configure for your email provider (e.g., Gmail SMTP)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=your-email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Upload Settings
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760
# Directory for file uploads
UPLOAD_FOLDER=./Uploads
# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=["pdf", "doc", "docx", "jpg", "jpeg", "png"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Timezone
DEFAULT_TIMEZONE=UTC

# Attendance and Shift Settings
# Require location for attendance tracking (default: False)
REQUIRE_ATTENDANCE_LOCATION=False
# Check holidays when recording attendance (default: True)
CHECK_HOLIDAYS_ON_ATTENDANCE=True
# Send notifications on attendance events (default: True)
NOTIFY_ON_ATTENDANCE=True
# Minimum shift duration in hours (default: 4.0)
MINIMUM_SHIFT_DURATION=4.0
# Maximum number of emergency contacts per employee (default: 3)
MAX_EMERGENCY_CONTACTS=3
# Maximum levels in approval workflow (default: 5)
MAX_WORKFLOW_LEVELS=5
# Prevent deletion of approved workflows (default: True)
PREVENT_DELETE_APPROVED_WORKFLOW=True
# Maximum allowed change in leave balance in days (default: 30.0)
MAX_BALANCE_CHANGE=30.0
# Prevent negative leave allocations (default: True)
PREVENT_NEGATIVE_ALLOCATION=True
# Check holidays when requesting leave (default: True)
CHECK_HOLIDAYS_ON_LEAVE=True
# Prevent deletion of approved leave requests (default: True)
PREVENT_DELETE_APPROVED_LEAVE=True
# Prevent deletion of approved overtime records (default: True)
PREVENT_DELETE_APPROVED_OVERTIME=True
# Check holidays when recording overtime (default: True)
CHECK_HOLIDAYS_ON_OVERTIME=True
# Default overtime pay rate multiplier (default: 1.5)
DEFAULT_OVERTIME_RATE=1.5
# Require active shift assignment for attendance (default: True)
REQUIRE_ACTIVE_SHIFT_ASSIGNMENT=True
# Maximum hours allowed for time corrections (default: 12.0)
MAX_TIME_CORRECTION_HOURS=12.0
# Prevent invalid time corrections (default: True)
PREVENT_INVALID_TIME_CORRECTIONS=True

# Overtime Settings
# Overtime threshold in hours per day (default: 8.0)
OVERTIME_THRESHOLD=8.0

# Materialized View Refresh Interval (in seconds, default: 1 hour)
MATERIALIZED_VIEW_REFRESH_INTERVAL=3600